<?php

use Krystal\Form\Element;
use Krystal\Widget\GridView\GridViewWidget;
use Cms\View\Icon;

?>

<form>
    <div class="btn-toolbar" role="toolbar">
        <div class="btn-group me-2" role="group">
            <?php $this->loadPartial('menu', [
                'items' => [
                    'Blog:Admin:Browser@indexAction' => isset($categoryId) ? 'Go home' : null,
                    'Blog:Admin:Post@addAction' => 'Add a post',
                    'Blog:Admin:Category@addAction' => 'Add category',
                    'Blog:Admin:Config@indexAction' => 'Configuration'
                ],

                'actions' => [
                    'data' => $posts,
                    'save' => 'Blog:Admin:Post@tweakAction',
                    'delete' => 'Blog:Admin:Post@deleteAction'
                ]
            ]); ?>
        </div>

        <div class="btn-group me-2">
            <button class="btn btn-primary" type="submit"><?= $this->translate('Filter') ?></button>
        </div>

        <?php if ($hasFilter): ?>
        <div class="btn-group me-2">
            <a class="btn btn-danger" href="<?= $this->url('Blog:Admin:Browser@indexAction') ?>"><?= $this->translate('Reset filter') ?></a>
        </div>
        <?php endif; ?>
    </div>

    <div class="card">
        <?php $this->loadPartial('items-per-page', ['caption' => 'Latest posts']); ?>

        <div class="table-responsive">
            <?= $this->widget(new GridViewWidget($posts, [
                'batch' => true,
                'pk' => 'id',
                'tableClass' => 'table table-hover table-bordered table-striped align-middle',
                'columns' => [
                    [
                        'column' => 'id',
                        'label' => '#'
                    ],

                    [
                        'sorting' => false,
                        'column' => 'name',
                        'filter' => true,
                        'attributes' => [
                            'class' => null
                        ]
                    ],

                    [
                        'column' => 'timestamp',
                        'label' => 'Date',
                        'value' => function ($post) {
                            return date('d-m-Y', $post->getTimestamp());
                        }
                    ],

                    [
                        'sorting' => false,
                        'name' => 'category_id',
                        'column' => 'category_name',
                        'label' => 'Category',
                        'type' => 'select',
                        'filter' => $tree,
                    ],

                    [
                        'column' => 'published',
                        'value' => function ($post) {
                            return Element::checkbox(sprintf('published[%s]', $post->getId()), $post->getPublished(), ['class' => 'form-check-input']);
                        }
                    ],

                    [
                        'column' => 'comments',
                        'value' => function ($post) {
                            return Element::checkbox(sprintf('comments[%s]', $post->getId()), $post->getComments(), ['class' => 'form-check-input']);
                        }
                    ],

                    [
                        'column' => 'seo',
                        'label' => 'Enable SEO',
                        'value' => function ($post) {
                            return Element::checkbox(sprintf('seo[%s]', $post->getId()), $post->getSeo(), ['class' => 'form-check-input']);
                        }
                    ]
                ],

                'actions' => [
                    function ($post) {
                        return Icon::view($post->getUrl(), $this->translate('View this post'));
                    },

                    function ($post) {
                        return Icon::edit(
                            $this->url('Blog:Admin:Post@editAction', $post->getId()),
                            $this->translate('Edit this post')
                        );
                    },

                    function ($post) {
                        return Icon::remove(
                            $this->url('Blog:Admin:Post@deleteAction', $post->getId()),
                            $this->translate('Remove this post')
                        );
                    }
                ]
            ])); ?>

            <?php if (empty($posts)): ?>
            <div class="text-center my-4">
                <h2 class="text-center text-muted"><i class="bi bi-x-circle"></i> <?= $this->translate('No posts') ?></h2>
            </div>
            <?php endif; ?>
        </div>

        <?php $this->loadPartial('paginator'); ?>
    </div>
</form>

<div class="card mt-3">
    <h4 class="mb-3 mt-2"><i class="fas fa-tags"></i> <?= $this->translate('Categories') ?> <small class="text-muted">(<?= count($categories) ?>)</small></h4>

    <?= $this->widget(new GridViewWidget($categories, [
        'tableClass' => 'table table-hover table-bordered table-striped align-middle',
        'rowAttributes' => [
            'class' => function ($row) use ($categoryId) {
                return $row['id'] == $categoryId ? 'table-success' : null;
            }
        ],

        'columns' => [
            [
                'column' => 'id',
                'label' => '#'
            ],

            [
                'column' => 'name',
                'attributes' => [
                    'class' => null
                ]
            ],

            [
                'column' => 'post_count',
                'label' => 'Amount of posts'
            ]
        ],

        'actions' => [
            function ($category) {
                return Icon::view($category['url'], $this->translate('View this category on site'));
            },

            function ($category) {
                return Icon::edit(
                    $this->url('Blog:Admin:Category@editAction', $category['id']),
                    $this->translate('Edit this category')
                );
            },

            function ($category) {
                return Icon::remove(
                    $this->url('Blog:Admin:Category@deleteAction', $category['id']),
                    $this->translate('Remove this category')
                );
            }
        ]
    ])); ?>

    <?php if (empty($categories)): ?>
    <div class="text-center my-4">
        <h2 class="text-center text-muted"><i class="bi bi-x-circle"></i> <?= $this->translate('No categories') ?></h2>
    </div>
    <?php endif; ?>
</div>