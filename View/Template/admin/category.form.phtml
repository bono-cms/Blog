<?php

use Krystal\Form\Element;
use Cms\Service\LanguageManager;

?>

<form class="card" autocomplete="off">
    <ul class="nav nav-tabs" role="tablist">
        <li role="presentation" class="nav-item">
            <a class="nav-link active" href="#page" role="tab" data-bs-toggle="tab"><i class="fas fa-tags"></i> <?= $this->translate('Category') ?></a>
        </li>
        <li role="presentation" class="nav-item">
            <a class="nav-link" href="#configuration" role="tab" data-bs-toggle="tab"><i class="fas fa-tasks"></i> <?= $this->translate('Configuration') ?></a>
        </li>
    </ul>

    <div class="tab-content">
        <div class="tab-pane fade show active" id="page" role="tabpanel">
            <?php $this->loadPartial('language-tabs'); ?>

            <div class="tab-content">
                <?php foreach ($languages as $index => $language): ?>
                <div class="tab-pane fade <?= $index == 0 ? 'show active' : '' ?>" id="<?php printf('language-%s', $language->getId()); ?>" role="tabpanel">
                    <?php $entity = LanguageManager::findByLangId($language->getId(), $category); ?>

                    <?= Element::hidden(sprintf('translation[%s][id]', $language->getId()), $entity->getId()) ?>
                    <?= Element::hidden(sprintf('translation[%s][web_page_id]', $language->getId()), $entity->getWebPageId()) ?>
                    <?= Element::hidden(sprintf('translation[%s][lang_id]', $language->getId()), $language->getId()) ?>

                    <?php $this->loadPartial('language-name', ['language' => $language]); ?>

                    <div class="mb-3 row">
                        <label class="col-lg-2 col-form-label"><?= $this->translate('Name') ?></label>
                        <div class="col-lg-10">
                            <div class="input-group">
                                <?= Element::text(sprintf('translation[%s][name]', $language->getId()), $entity->getName(), ['class' => 'form-control', 'placeholder' => $this->translate('Category name')]) ?>
                                <span class="input-group-text"><i class="bi bi-pencil"></i></span>
                            </div>
                        </div>
                    </div>

                    <div class="mb-3 row">
                        <label class="col-lg-2 col-form-label"><?= $this->translate('Description') ?></label>
                        <div class="col-lg-10">
                            <?= Element::textarea(sprintf('translation[%s][description]', $language->getId()), $entity->getDescription(), ['data-wysiwyg' => 'true']) ?>
                        </div>
                    </div>

                    <div class="options">
                        <div class="mb-3 row">
                            <label class="col-lg-2 col-form-label"><?= $this->translate('Slug') ?></label>
                            <div class="col-lg-10">
                                <div class="input-group">
                                    <?= Element::text(sprintf('translation[%s][slug]', $language->getId()), $entity->getSlug(), ['class' => 'form-control', 'placeholder' => $this->translate('URL slug for this category. By default its taken from the name')]) ?>

                                    <span class="input-group-text">
                                        <a href="#" data-slug-selector="<?= LanguageManager::generateSelector($language->getId()) ?>"><i class="bi bi-arrow-repeat" data-bs-toggle="tooltip" title="<?= $this->translate('Refresh the slug') ?>"></i></a>
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3 row">
                            <label class="col-lg-12 col-form-label"><?= $this->translate('Change frequency') ?></label>
                            <div class="col-lg-10">
                                <?= Element::select(sprintf('translation[%s][changefreq]', $language->getId()), $this->translateArray($changeFreqs), $entity->getChangeFreq(), ['class' => 'form-select']) ?>
                            </div>
                        </div>

                        <div class="mb-3 row">
                            <label class="col-lg-2 col-form-label"><?= $this->translate('Priority') ?></label>
                            <div class="col-lg-10">
                                <?= Element::select(sprintf('translation[%s][priority]', $language->getId()), $priorities, $entity->getPriority(), ['class' => 'form-select']) ?>
                            </div>
                        </div>

                        <div class="mb-3 row">
                            <label class="col-lg-2 col-form-label"><?= $this->translate('Title') ?></label>
                            <div class="col-lg-10">
                                <div class="input-group">
                                    <?= Element::text(sprintf('translation[%s][title]', $language->getId()), $entity->getTitle(), ['class' => 'form-control', 'data-input' => 'title', 'placeholder' => $this->translate('Category title')]) ?>
                                    <span class="input-group-text"><i class="bi bi-pencil"></i></span>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3 row">
                            <label class="col-lg-2 col-form-label"><?= $this->translate('Keywords') ?></label>
                            <div class="col-lg-10">
                                <?= Element::textarea(sprintf('translation[%s][keywords]', $language->getId()), $entity->getKeywords(), ['class' => 'form-control', 'placeholder' => $this->translate('Keywords used for search engines')]) ?>
                            </div>
                        </div>

                        <div class="mb-3 row">
                            <label class="col-lg-2 col-form-label"><?= $this->translate('Meta-Description') ?></label>
                            <div class="col-lg-10">
                                <?= Element::textarea(sprintf('translation[%s][meta_description]', $language->getId()), $entity->getMetaDescription(), ['class' => 'form-control', 'placeholder' => $this->translate('Meta description for search engines')]) ?>
                            </div>
                        </div>
                    </div>
                </div>
                <?php endforeach; ?>
            </div>
        </div>

        <div role="tabpanel" class="tab-pane" id="configuration">
            <?= Element::hidden('category[id]', $entity->getId()) ?>
            <?= Element::hidden('category[cover]', $entity->getCover()) ?>

            <div class="mb-3 row">
                <label class="col-lg-2 col-form-label"><?= $this->translate('Parent category') ?></label>
                <div class="col-lg-10">
                    <?= Element::select('category[parent_id]', $categories, $entity->getParentId(), ['class' => 'form-select']) ?>
                </div>
            </div>

            <div class="mb-3 row">
                <label class="col-lg-2 col-form-label"><?= $this->translate('Order') ?></label>
                <div class="col-lg-10">
                    <div class="input-group">
                        <?= Element::number('category[order]', $entity->getOrder(), ['class' => 'form-control', 'placeholder' => $this->translate('Category order')]) ?>
                        <span class="input-group-text"><i class="bi bi-pencil"></i></span>
                    </div>
                </div>
            </div>

            <div class="mb-3 row">
                <label class="col-lg-2 col-form-label"><?= $this->translate('Enable SEO') ?></label>
                <div class="col-lg-10">
                    <div class="form-check">
                        <?= Element::checkbox('category[seo]', $entity->getSeo(), ['class' => 'form-check-input']) ?>
                    </div>
                </div>
            </div>

            <!--Cover-->
            <div class="mb-3 row">
                <label class="col-lg-2 col-form-label"><?= $this->translate('Cover') ?></label>
                <div class="col-lg-10">
                    <br />
                    <?php if ($entity->hasCover()): ?>
                    <p><img src="<?= $entity->getImageUrl('200x200') ?>" class="img-fluid" /></p>

                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="removeCover" name="category[remove_cover]" data-bs-toggle="tooltip" data-bs-placement="left" title="<?= $this->translate('Check it if you want to remove this cover') ?>" />
                        <label class="form-check-label" for="removeCover"><?= $this->translate('Remove this cover') ?></label>
                    </div>
                    <?php else: ?>
                    <p><img data-image="preview" class="img-fluid" /></p>
                    <?php endif; ?>

                    <a class="btn btn-primary" data-button="upload" data-target="[name='file']" href="#"><i class="bi bi-image"></i> <?= $this->translate('Upload a file') ?></a>
                    <?= Element::file('file', 'image/x-png, image/gif, image/jpeg', ['class' => 'd-none', 'data-plugin' => 'preview']) ?>
                </div>
            </div>
            <!--/Cover-->
        </div>
    </div>

    <?php $this->loadPartial('actions', [
        'new' => !$entity->getId(),
        'add' => 'Blog:Admin:Category@addAction',
        'edit' => 'Blog:Admin:Category@editAction',
        'save' => 'Blog:Admin:Category@saveAction',
        'cancel' => 'Blog:Admin:Browser@indexAction',
        'options' => true
    ]); ?>

</form>