<?php

use Krystal\Form\Element;

?>

<form class="card" autocomplete="off">
    <?= Element::hidden('image[id]', $image->getId()) ?>
    <?= Element::hidden('image[image]', $image->getImage()) ?>
    <?= Element::hidden('image[post_id]', $image->getPostId()) ?>

    <div class="mb-3 row">
        <label class="col-lg-2 col-form-label"><?= $this->translate('Image') ?></label>
        <div class="col-lg-10">
            <p>
                <img data-image="<?= $image->getId() ? null : 'preview' ?>" src="<?= $image->getImageUrl('400x400') ?>" class="img-fluid" />
            </p>

            <a class="btn btn-primary" data-button="upload" data-target="[name='file']" href="#"><i class="bi bi-image"></i> <?= $this->translate('Upload a file') ?></a>
            <?= Element::file('file', 'image/x-png, image/gif, image/jpeg', ['class' => 'd-none', 'data-plugin' => 'preview']) ?>
        </div>
    </div>

    <div class="mb-3 row">
        <label class="col-lg-2 col-form-label"><?= $this->translate('Order') ?></label>
        <div class="col-lg-10">
            <div class="input-group">
                <?= Element::text('image[order]', $image->getOrder(), ['class' => 'form-control', 'placeholder' => $this->translate('Sorting order')]) ?>
                <span class="input-group-text"><i class="bi bi-pencil"></i></span>
            </div>
        </div>
    </div>

    <?php $this->loadPartial('actions', [
        'new' => !$image->getId(),
        'add' => ['Blog:Admin:PostGallery@addAction', $image->getPostId()],
        'edit' => 'Blog:Admin:PostGallery@editAction',
        'save' => 'Blog:Admin:PostGallery@saveAction',
        'cancel' => ['Blog:Admin:Post@editAction', $image->getPostId()]
    ]); ?>

</form>